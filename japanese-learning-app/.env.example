# ============================================================
# Nihongo Rewards – Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# Never commit .env.local or real secrets to git.
# ============================================================

# Supabase Project URL (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon / public key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: Site URL used in emails / redirects (set in Supabase Auth settings too)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
