# ============================================================
# Nihongo Rewards – Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# Never commit .env.local or real secrets to git.
# ============================================================

# Supabase Project URL (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon / public key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: Site URL used in emails / redirects (set in Supabase Auth settings too)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# Phase 5 – Optional AI parser (server-side only)
# ============================================================
# Leave unset to use deterministic TXT parser only.
# AI_PARSER_ENABLED=false
# AI_PARSER_PROVIDER=none
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ============================================================
# Phase 7 – no extra required secrets
# ============================================================
# Contact/support values are stored in system_settings (admin UI).
# Keep service_role and payment/AI keys server-only — never NEXT_PUBLIC_*.
