# ============================================================
# Nihongo Rewards – Environment Variables
# ============================================================
# Copy to .env.local for local dev. On Vercel, set in Project → Settings → Environment Variables.
# NEVER commit real secrets. NEVER put service_role in NEXT_PUBLIC_*.
# ============================================================

# --- Public (safe in browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Production site origin (custom domain preferred). Used for referral links & metadata.
# Example: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (optional; never NEXT_PUBLIC_) ---
# AI_PARSER_ENABLED=false
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Supabase service_role key is NOT used by this app frontend.
# Use it only in Supabase Dashboard / secure server scripts — never in Vercel NEXT_PUBLIC_*.
